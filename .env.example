# 复制为 .env 后按需填写。环境变量同名时优先于 .env。.env 已在 .gitignore 中，不要提交。
# 查找顺序：项目目录/.env → 当前目录/.env → 仓库根目录/.env

# ---------- 配音 TTS / 语音识别 ----------
# Fish Audio（https://fish.audio）：TTS 和 ASR 对齐都用它；不填则用 edge-tts（免费）+ 静音对齐（离线）
FISH_API_KEY=
# 音色 reference_id（在 fish.audio 音色页复制）
FISH_VOICE_ID=
# TTS 模型（s1 / speech-1.6 / drama-3 等，以官网为准）
FISH_MODEL=s1
# 需要代理时填，例如 http://127.0.0.1:7890；requests 不读系统代理
FISH_PROXY=

# ---------- AI 出图：接入你自己的出图 API（必填其一，否则出图这一步会停下来提醒） ----------
# 平台：ark（火山方舟 · 豆包 Seedream）| dashscope（阿里云百炼 · 通义万相）| siliconflow（硅基流动）
#       | openai（OpenAI 或任意 OpenAI 兼容接口 / 中转，需填 IMAGE_API_BASE）| command（自己的出图命令）| manual（人工出图）
IMAGE_PROVIDER=
IMAGE_API_KEY=
# 模型 ID（不填用默认：ark=doubao-seedream-4-0-250828，dashscope=wan2.2-t2i-flash，siliconflow=Kwai-Kolors/Kolors）
IMAGE_MODEL=
# 接口地址（不填用平台默认）
IMAGE_API_BASE=
# 尺寸，例如 2048x2048（不填用平台默认）
IMAGE_SIZE=
# 额外请求参数（JSON），例如 {"watermark": false}
IMAGE_EXTRA_JSON=
# command 模式：模板变量 {prompt} {prompt_file} {out} {ref} {size} {id}
# SCRIPTCUT_IMAGE_CMD=python my_gen.py --prompt-file {prompt_file} --out {out}
SCRIPTCUT_IMAGE_CMD=

# ---------- HTTP 版 MCP（豆包连接器 / 扣子等） ----------
# scriptcut serve 的访问口令与允许访问的工作目录（也可以用命令行 --token / --root）
SCRIPTCUT_MCP_TOKEN=
SCRIPTCUT_WORKSPACE=

# ---------- 剪映 ----------
# 剪映草稿目录；留空则 Windows 用 %LOCALAPPDATA%/JianyingPro/User Data/Projects/com.lveditor.draft，
# macOS 用 ~/Movies/JianyingPro/User Data/Projects/com.lveditor.draft，其他系统写到项目 build/jianying/
JIANYING_DRAFT_DIR=

# ---------- 字体 ----------
# 中文字体文件（本地渲染文字 / Canvas 出片共用）；留空则自动在系统字体目录里找思源黑体 / 微软雅黑 / 苹方
SCRIPTCUT_FONT=
